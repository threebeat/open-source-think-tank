{
  "name": "open-source-think-tank",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:gated": "npm run db:up && node scripts/gated-e2e-prepare.mjs && node scripts/gated-e2e-build.mjs && playwright test -c playwright.gated.config.ts",
    "db:seed": "tsx scripts/seed-synthetic.ts",
    "operator:bootstrap": "tsx scripts/operator-bootstrap.ts",
    "capture:screenshots": "node scripts/capture-presentation-backup.mjs",
    "db:up": "node scripts/db-up.mjs",
    "db:down": "docker compose down",
    "db:wait": "node scripts/wait-for-postgres.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "security:check": "node scripts/security-checks.mjs",
    "backup:smoke": "tsx scripts/backup-restore-smoke.ts",
    "operator:reset-alpha": "tsx scripts/operator-reset-alpha.ts",
    "alpha:reset:smoke": "tsx scripts/alpha-reset-smoke.ts",
    "test:pg:invites": "OSTT_REQUIRE_POSTGRES=1 vitest run src/lib/invites/issue.pg.test.ts",
    "test:pg:alpha-reset": "OSTT_REQUIRE_POSTGRES=1 vitest run src/lib/operator/alpha-reset.pg.test.ts",
    "test:pg:reports": "OSTT_REQUIRE_POSTGRES=1 vitest run src/lib/public-input/reports/report-integrity.pg.test.ts",
    "test:pg:organizations": "OSTT_REQUIRE_POSTGRES=1 vitest run src/lib/organizations/isolation.pg.test.ts",
    "test:pg:enrollment": "OSTT_REQUIRE_POSTGRES=1 vitest run src/lib/auth/enrollment.pg.test.ts",
    "phase3:acceptance": "tsx scripts/phase-3-acceptance-journey.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
