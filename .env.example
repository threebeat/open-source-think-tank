# public-demo (default): leave APP_MODE unset or set public-demo.
# Gated secrets must be unset in public-demo or the app fails closed.
APP_MODE=public-demo

# --- Gated local foundation only (never commit real secrets) ---
# APP_MODE=gated
# DATABASE_URL=postgres://ostt:ostt@127.0.0.1:54329/ostt_dev
# AUTH_SECRET=
# AUTH_URL=http://127.0.0.1:3000
# AUTH_E2E_CAPTURE=1
# EMAIL_API_KEY=
# COMMONHALL_V2_KERNEL defaults on in gated; set off to kill kernel writes.
# COMMONHALL_V2_OPEN_ENROLLMENT defaults on in gated; set off to pause join.
# COMMONHALL_SYNTHETIC_SEED defaults on in gated; set off to hide synthetic catalog rows.
# First-administrator operator ceremony (3.3) — never commit real values;
# never pass OPERATOR_BOOTSTRAP_SECRET on the command line.
# OPERATOR_BOOTSTRAP_SECRET=
# OPERATOR_LABEL=
